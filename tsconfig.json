{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/components/app-sidebar": [
        "./src/registry/base/blocks/sidebar/01/components/app-sidebar.tsx"
      ],
      "@/components/ui/breadcrumbs": ["./src/registry/base/breadcrumbs.tsx"],
      "@/components/ui/calendar": ["./src/registry/base/calendar.tsx"],
      "@/components/ui/date-picker": ["./src/registry/base/date-picker.tsx"],
      "@/components/ui/date-input": ["./src/registry/base/date-input.tsx"],
      "@/components/ui/input-group": ["./src/registry/base/input-group.tsx"],
      "@/components/ui/select": ["./src/registry/base/select.tsx"],
      "@/lib/date": ["./src/registry/base/date.ts"],
      "@/components/*": ["./src/shared/components/*"],
      "@/hooks/*": ["./src/shared/hooks/*"],
      "@/lib/*": ["./src/shared/lib/*"],
      "@/*": ["./src/*"],
      "collections/*": ["./.source/*"]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "content/**/*.mdx",
    "scripts/**/*.mjs",
    "scripts/**/*.mts",
    ".source/**/*.ts",
    "source.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", ".next", "app"]
}
