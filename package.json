{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp run build:site",
    "preview": "vp preview",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:check": "node scripts/check-docs.mjs",
    "registry:build": "shadcn build registry.json --output ./public/r",
    "static:build": "node scripts/generate-static-assets.mjs",
    "postinstall": "fumadocs-mdx",
    "check": "vp check",
    "fix": "vp check --fix",
    "prepare": "vp config",
    "deps": "vpx taze@latest -Ilwr --maturity-period 3 --exclude ts-morph",
    "deps:major": "vpx taze@latest major -Ilwr --maturity-period 3 --exclude ts-morph",
    "tanstack": "pnpm dlx @tanstack/cli@latest",
    "skills": "pnpm dlx skills@latest",
    "intent": "pnpm dlx @tanstack/intent@latest"
  },
  "dependencies": {
    "@ark-ui/react": "catalog:",
    "@base-ui/react": "catalog:",
    "@bprogress/react": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@internationalized/date": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-table": "catalog:",
    "calligraph": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "fumadocs-core": "catalog:",
    "hashvatar": "^0.1.2",
    "input-otp": "^1.5.0",
    "jotai": "catalog:",
    "lru-cache": "catalog:",
    "lucide-react": "catalog:",
    "match-sorter": "^8.3.0",
    "motion": "catalog:",
    "next-themes": "catalog:",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hotkeys-hook": "catalog:",
    "react-resizable-panels": "^4.12.4",
    "shiki": "catalog:",
    "sonner": "catalog:",
    "tailwind-variants": "^3.3.1",
    "takumi-js": "^2.13.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@testing-library/react": "16.3.0",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "fumadocs-mdx": "catalog:",
    "jsdom": "27.1.0",
    "rehype-pretty-code": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "4.1.11",
    "wrangler": "^4.130.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.0",
      "onFail": "download"
    }
  }
